// 共用設定。個人簽章設定放在 Config/Local.xcconfig.local（已 gitignore），例如：
//   DEVELOPMENT_TEAM = ABCDE12345
//   BUNDLE_ID_PREFIX = com.yourname
BUNDLE_ID_PREFIX = com.jordan9185
DEVELOPMENT_TEAM =
APP_GROUP_ID = group.$(BUNDLE_ID_PREFIX).beartravel

// 簽章用的 entitlements。免費的個人開發帳號若不支援 App Group，在 Local.xcconfig.local 改成：
//   APP_ENTITLEMENTS = Config/NoAppGroup.entitlements
//   EXTENSION_ENTITLEMENTS = Config/NoAppGroup.entitlements
// （分享擴充功能就無法與 App 共用登入、草稿與離線快取；App 改用自己的 Keychain 保存登入。）
APP_ENTITLEMENTS = App/BearTravel.entitlements
EXTENSION_ENTITLEMENTS = ShareExtension/ShareExtension.entitlements

// 後端：預設為本機 `supabase start`（xcconfig 會把 // 當註解，所以用 $() 隔開）。
// 本機 anon key 由 `supabase status` 取得；連雲端專案時在 Local.xcconfig.local 覆寫兩者。
SUPABASE_URL = http:/$()/127.0.0.1:54321
SUPABASE_ANON_KEY =

#include? "Local.xcconfig.local"
